# .env
# To connect to Supabase, one needs a Supabase project.
# Create a project at https://supabase.com and set up your database.
# Replace <your_password> and <your_db> with your actual database password and database name
# in the following line.
SUPABASE_PASSWORD=YOUR-SUPABASE-PASSWORD
SUPABASE_HOST=YOUR-SUPABASE-DB-HOST
